# Copia este archivo como .env (no se versiona) y ajusta los valores.
# Desarrollo: PostgreSQL local (nativo o docker-compose). Producción: Neon (se configura en la Fase 2).
PGHOST=localhost
PGPORT=5432
PGDATABASE=observatorio
PGUSER=observatorio
PGPASSWORD=cambia-esta-contrasena-local
PGSSLMODE=disable
